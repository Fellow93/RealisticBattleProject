<Project Sdk="Microsoft.NET.Sdk">
  <!-- Executable specifications for RBMAI's game-free battle-AI rules. Not in RealisticBattle.sln, so the
       mod's command-line build (no /restore) is unaffected. Build + run: see README.md. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <GameBin>$(MSBuildThisFileDirectory)..\..\..\bin\Win64_Shipping_Client\</GameBin>
    <RbmBin>$(MSBuildThisFileDirectory)..\..\RBM\bin\Win64_Shipping_Client\</RbmBin>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- RBMAI's post-build xcopy paths are built on $(SolutionDir). -->
    <ProjectReference Include="..\RealisticBattleAiModule\RBMAI.csproj" AdditionalProperties="SolutionDir=$(MSBuildThisFileDirectory)..\" />
  </ItemGroup>

  <!-- Compile-time only: Vec2 and the Formation-typed snapshot members. -->
  <ItemGroup>
    <Reference Include="TaleWorlds.Library">
      <HintPath>$(GameBin)TaleWorlds.Library.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.MountAndBlade">
      <HintPath>$(GameBin)TaleWorlds.MountAndBlade.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- The game's assemblies are never copied here; GameAssemblies resolves them from these folders. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GameBin</_Parameter1>
      <_Parameter2>$(GameBin)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RbmBin</_Parameter1>
      <_Parameter2>$(RbmBin)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
