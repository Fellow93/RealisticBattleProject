  <Brush Name="ButtonTalkBrush">
    <Layers>
      <BrushLayer Name="Default" Sprite="Icons\Talk@2x" Color="#FFFFFFFF" />
      <BrushLayer Name="Hovered" Sprite="Icons\Talk@2x" Color="#FFFFFFFF" />
      <BrushLayer Name="Pressed" Sprite="Icons\Talk@2x" Color="#FFFFFFFF" />
    </Layers>
    <Styles>
      <Style Name="Default" FontColor="#FAF4DEFF">
        <BrushLayer Name="Hovered" IsHidden="true" />
        <BrushLayer Name="Pressed" IsHidden="true" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Default" IsHidden="true" />
        <BrushLayer Name="Pressed" IsHidden="true" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" IsHidden="true" />
        <BrushLayer Name="Hovered" IsHidden="true" />
      </Style>
    </Styles>
  </Brush>
</Brushes>
