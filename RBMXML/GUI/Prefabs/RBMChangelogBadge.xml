<Prefab>
	<!-- Title-screen badges, top-right corner (RBMConfig.RBMChangelog adds them as its own layer on the native
	     initial screen): "RBM Changelog" with "RBM Manual" stacked under it. The native InitialScreen.xml puts
	     nothing there in single player: its only top-right widget is the console profile box
	     (IsProfileSelectionEnabled, never set on PC), at the same 25 px from the top. The full-screen root takes
	     no events, so clicks anywhere else reach the menu. Each badge is as wide as its own label; the stack
	     right-aligns them, so the changelog badge sits exactly where it would on its own. -->
	<Window>
		<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" DoNotAcceptEvents="true">
			<Children>

				<ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
						   HorizontalAlignment="Right" VerticalAlignment="Top" MarginTop="25" MarginRight="25"
						   StackLayout.LayoutMethod="VerticalTopToBottom" DoNotAcceptEvents="true">
					<Children>

						<ButtonWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="46"
									  HorizontalAlignment="Right"
									  Brush="RBMChangelog.Badge" Command.Click="ExecuteOpen"
									  DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
							<Children>
								<TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
											MarginLeft="22" MarginRight="22" DoNotAcceptEvents="true"
											Brush="RBMChangelog.Badge.Text" Text="@BadgeText" />

								<!-- "New" dot while the newest version has not been opened yet. -->
								<Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="14" SuggestedHeight="14"
										HorizontalAlignment="Right" VerticalAlignment="Top" PositionXOffset="5" PositionYOffset="-5"
										Sprite="BlankWhiteCircle" Color="#E8A33CFF" DoNotAcceptEvents="true" IsVisible="@HasUnseen" />
							</Children>
						</ButtonWidget>

						<!-- Opens the online player manual in the browser; no dot, no overlay. -->
						<ButtonWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="46"
									  HorizontalAlignment="Right" MarginTop="8"
									  Brush="RBMChangelog.Badge" Command.Click="ExecuteOpenManual"
									  DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
							<Children>
								<TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
											MarginLeft="22" MarginRight="22" DoNotAcceptEvents="true"
											Brush="RBMChangelog.Badge.Text" Text="@ManualText" />
							</Children>
						</ButtonWidget>

					</Children>
				</ListPanel>

			</Children>
		</Widget>
	</Window>
</Prefab>
